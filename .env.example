# DogSense Live — local defaults only. Copy to .env; never put real secrets here.

# Runtime
APP_ENV=development
DOGSENSE_DEMO_MODE=true
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DOGSENSE_BIND_HOST=127.0.0.1

# Local authentication. Replace both values before exposing the stack to a network.
AUTH_MODE=local
LOCAL_AUTH_TOKEN=dogsense-local-demo
DOGSENSE_API_TOKEN=demo-local-token
AUTH_REQUIRED=false
JWT_SECRET=dogsense-local-demo-not-for-production
CREDENTIAL_ENCRYPTION_KEY=dogsense-demo-encryption-key-change-me
INTERNAL_API_TOKEN=dogsense-worker-demo-token

# PostgreSQL (the database has no published host port by default)
POSTGRES_USER=dogsense
POSTGRES_PASSWORD=dogsense-local
POSTGRES_DB=dogsense
POSTGRES_DSN=postgresql+asyncpg://dogsense:dogsense-local@postgres:5432/dogsense
DATABASE_URL=postgresql+asyncpg://dogsense:dogsense-local@postgres:5432/dogsense
STORE_BACKEND=postgres

# Video relay. Leave CAMERA_RTSP_URL empty in deterministic demo mode.
CAMERA_NAME=Demo camera
CAMERA_RTSP_URL=
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554/dog-camera
MEDIAMTX_WEBRTC_URL=http://localhost:8889/dog-camera/whep
NEXT_PUBLIC_VIDEO_URL=http://localhost:8889/dog-camera/whep
NEXT_PUBLIC_DOG_ID=demo-dog
NEXT_PUBLIC_LOCAL_TOKEN=demo-local-token
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_MODE=real
CAMERA_ADAPTER=fake
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=

# Capture and temporal analysis
FRAME_WINDOW_SECONDS=4
FRAME_SAMPLE_FPS=2
ANALYSIS_INTERVAL_SECONDS=2
INFERENCE_IMAGE_WIDTH=640
INFERENCE_IMAGE_HEIGHT=360
INFERENCE_JPEG_QUALITY=75
MAX_QUEUED_WINDOWS=1
TEMPORAL_ALPHA=0.35
STATE_CONFIDENCE_THRESHOLD=0.65
DOGSENSE_FAKE_SCENARIO_PATH=/demo/scenarios/demo-tour.json
DOGSENSE_CAMERA_ID=00000000-0000-0000-0000-000000000001
DOGSENSE_SESSION_ID=00000000-0000-0000-0000-000000000003

# Google AI. Fake mode is deterministic and needs no key.
DOGSENSE_AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=8
PROMPT_VERSION=behavior-observer-v1

# Snowflake. Fake mode writes no data outside the local stack.
SNOWFLAKE_MODE=fake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=DOGSENSE
SNOWFLAKE_SCHEMA=BEHAVIOR
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_HOST_PATH=
SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake-private-key
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
ANALYTICS_HMAC_KEY=dogsense-demo-analytics-key-change-me

# ElevenLabs. Fake mode returns an auditable local placeholder without an API call.
ELEVENLABS_MODE=fake
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
SPEECH_TTL_HOURS=24

# Solana. Fake mode creates a deterministic local receipt only.
SOLANA_MODE=fake
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
SOLANA_KEYPAIR_HOST_PATH=
SOLANA_KEYPAIR_PATH=/run/secrets/solana-keypair

# Optional telemetry. Empty means no remote exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
